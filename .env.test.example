# Test API Keys for LLM Fallback Testing
# Copy this file to .env.test and fill in your actual keys

# DeepSeek API Key
DEEPSEEK_API_KEY=your-deepseek-key-here

# ZhipuAI API Key
ZHIPU_AI_API_KEY=your-zhipuai-key-here

# ===========================================
# RAGFlow Integration Test Configuration
# ===========================================

# RAGFlow 服务地址
RAGFLOW_HOST=http://localhost:9380

# RAGFlow API Token (从数据库 api_token 表获取)
# 获取命令: docker exec docker-mysql-1 mysql -uroot -pinfini_rag_flow rag_flow -e "SELECT token FROM api_token LIMIT 1;"
RAGFLOW_API_KEY=your-ragflow-api-key-here
